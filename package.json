{
  "name": "football-life",
  "version": "0.1.5",
  "private": true,
  "description": "Fuoriclasse: simulatore di carriera calcistica — monorepo",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta npm:dev:server npm:dev:web",
    "dev:server": "npm run dev --workspace @football-life/server",
    "dev:web": "npm run dev --workspace @football-life/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:statistical": "vitest run packages/simulation-engine/src/career/career-simulator.test.ts packages/simulation-engine/src/match/match-engine.test.ts packages/simulation-engine/src/wellbeing/wellbeing.test.ts",
    "simulate:careers": "tsx scripts/simulate-careers.ts",
    "editor": "tsx scripts/editor.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "desktop:dev": "electron apps/desktop",
    "notices": "node scripts/generate-notices.mjs",
    "desktop:stage": "node scripts/build-desktop.mjs",
    "desktop:package": "npm run desktop:stage && electron-builder --publish never",
    "desktop:package:mac": "npm run desktop:stage && electron-builder --mac --publish never",
    "desktop:package:win": "npm run desktop:stage && electron-builder --win --publish never"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "com.davidesimonetti.fuoriclasse",
    "productName": "Fuoriclasse",
    "copyright": "© Davide Simonetti — tutti i diritti riservati",
    "directories": {
      "app": "apps/desktop/build/app",
      "output": "apps/desktop/release",
      "buildResources": "apps/desktop"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "apps/desktop/build/resources",
        "to": "."
      }
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.sports",
      "icon": "apps/desktop/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Fuoriclasse"
    },
    "win": {
      "icon": "apps/desktop/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fuoriclasse"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "concurrently": "^9.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
